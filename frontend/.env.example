# ---------------------------------------------------------------------------
# EV-CMS frontend environment
# Copy this file to `.env.local` (git-ignored) and adjust if your ports differ.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Never put secrets here — anything with this prefix is publicly visible.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
