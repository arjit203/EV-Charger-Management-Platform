# ---------------------------------------------------------------------------
# EV-CMS backend environment
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# PRODUCTION (NODE_ENV=production, e.g. Render): the server REFUSES TO START unless
#   - MONGODB_URI names its own database (not ev_cms, and not missing: /evcms_prod)
#   - CORS_ORIGIN is set to the https frontend origin(s), no localhost
#   - JWT_SECRET is a new random value of at least 32 characters
#   - RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are both set, with an rzp_test_ key
# In EVERY environment an rzp_live_ key is refused: EV-CMS runs Razorpay in test mode only.
# Production values live in the Render dashboard, never in this file or in .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# API
API_PREFIX=/api/v1

# Browser origin allowed to call this API (the Next.js dev server).
# Comma-separate if you ever need more than one.
CORS_ORIGIN=http://localhost:3000

# MongoDB connection string.
# Local install : mongodb://127.0.0.1:27017/ev_cms
# Atlas cluster : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ev_cms?retryWrites=true&w=majority
MONGODB_URI=

# --- Module 1: Authentication ---
# Signing key for JWTs. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every issued token.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Module 6: OCPP gateway ---
# Seconds of heartbeat silence before a charger is marked offline (3 missed 30s beats).
OCPP_OFFLINE_AFTER_SECONDS=90

# --- Module 7: Charging sessions ---
# Seconds a session may wait in `initiating` for the charger to confirm the start before
# it is failed and the connector reservation released.
SESSION_START_TIMEOUT_SECONDS=20

# --- Module 10: Razorpay (TEST MODE ONLY) ---
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys, in TEST mode.
# Leave them EMPTY to run against the deterministic stub provider — signature verification
# is still real (it is our own HMAC), only the network call to create an order is stubbed.
# NEVER put live-mode credentials here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you configure a webhook in the Razorpay dashboard. Used to verify its signature.
RAZORPAY_WEBHOOK_SECRET=

# --- Seeding (one-off: set IN THE SHELL for a single command, never here) ---
# This file's MONGODB_URI is the DEVELOPMENT database (ev_cms). Production seeding is opt-in:
# pass the production MONGODB_URI (…/evcms_prod) and SEED_CONFIRM_DB=evcms_prod in the shell.
# The seed scripts refuse, without connecting, if this file itself points at evcms_prod.
# SEED_CONFIRM_DB=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=      # production: required, 12+ chars. There is no in-app password change.
# SEED_DEMO_PASSWORD=       # production: shared password for seeded staff and drivers, 12+ chars
