{
  "name": "ev-cms-backend",
  "version": "0.1.0",
  "description": "EV Charging Management Platform - backend API, OCPP gateway and Socket.IO server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx src/scripts/seedDemoCompanies.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "test": "node ../tests/run.mjs",
    "test:list": "node ../tests/run.mjs --list",
    "test:clean": "node ../tests/cleanup.mjs",
    "lint": "eslint src",
    "seed:activity": "tsx src/scripts/seedDemoActivity.ts",
    "fix:settlement-backoff": "tsx src/scripts/backfillSettlementBackoff.ts",
    "fix:arrears": "tsx src/scripts/clearArrears.ts",
    "fix:session-hardware": "tsx src/scripts/backfillSessionHardware.ts",
    "fix:station-location": "tsx src/scripts/backfillStationLocation.ts",
    "fix:session-end": "tsx src/scripts/backfillSessionEnd.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.1",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
